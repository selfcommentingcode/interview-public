{
  "info": {
    "_postman_id": "crm-api-java-collection",
    "name": "CRM API (Java) - Local",
    "description": "End-to-end tests for the Java CRM API + the global leaky-bucket rate limiter.\n\nSet the 'CRM API - Local' environment before running.\nRun folders individually (not the whole collection at once): the Rate Limit folder needs limit=10, the Functional folder needs a raised limit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "contactId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Sanity",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body = ok\", () => pm.expect(pm.response.text()).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
