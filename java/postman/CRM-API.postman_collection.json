    {
      "name": "2 · Functional E2E  (raise limit first)",
      "description": "Full CRUD + files + reports. These share the 10/min budget, so START THE SERVER WITH A RAISED LIMIT before running: ./mvnw -q spring-boot:run -Dspring-boot.run.arguments=\"--app.rate-limit.requests-per-minute=1000\"",
      "item": [
        {
          "name": "Create contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/contacts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"555-0100\",\n  \"company\": \"Acme\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"has id\", () => pm.expect(b.id).to.be.a(\"string\").and.to.have.length.above(0));",
                  "pm.test(\"email echoed\", () => pm.expect(b.email).to.eql(\"jane.doe@example.com\"));",
                  "pm.collectionVariables.set(\"contactId\", b.id);",
                  "console.log(\"contactId =\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get contact",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts",
                "{{contactId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"id matches created\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"contactId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update contact",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts",
                "{{contactId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"555-0100\",\n  \"company\": \"Acme (updated)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"company updated\", () => pm.expect(pm.response.json().company).to.eql(\"Acme (updated)\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List contacts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contacts?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"contacts array present\", () => pm.expect(b.contacts).to.be.an(\"array\").with.length.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Import contacts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/contacts/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts",
                "import"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"first_name\": \"Imp\",\n    \"last_name\": \"One\",\n    \"email\": \"imp1@example.com\",\n    \"phone\": \"555-0001\",\n    \"company\": \"ImpCo\"\n  },\n  {\n    \"first_name\": \"Imp\",\n    \"last_name\": \"Two\",\n    \"email\": \"imp2@example.com\",\n    \"phone\": \"555-0002\",\n    \"company\": \"ImpCo\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"imported = 2\", () => pm.expect(pm.response.json().imported).to.eql(2));"
                ]
              }
            }
          ]
        },
